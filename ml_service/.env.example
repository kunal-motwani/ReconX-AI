# LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Vector DB
VECTOR_DB_PATH=./data/vectorstore

# Thresholds
GL_AUTO_APPROVAL_THRESHOLD=0.90
RECONCILIATION_AUTO_MATCH_THRESHOLD=0.95
ANOMALY_REVIEW_THRESHOLD=0.70

# Matching Weights (JSON)
MATCHING_WEIGHTS={"amount": 0.35, "vendor": 0.20, "date": 0.15, "reference": 0.20, "description": 0.10}

# Date tolerance in days
DATE_TOLERANCE_DAYS=3

# Amount tolerance percentage
AMOUNT_TOLERANCE_PERCENT=1.0

# OCR
OCR_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
